## prediction age groups ##
nd = expand.grid(resp_age_by5_80 = levels(merged.df$resp_age_by5_80),
cont_age_by5_80 = levels(merged.df$cont_age_by5_80))
predict.m = as.data.frame(nd)
## matrices
by5_matrix = calc.m.num(mydata = merged.df,
